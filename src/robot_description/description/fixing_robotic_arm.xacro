<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    
    <xacro:property name="box_x" value="0.3"/>
    <xacro:property name="box_y" value="0.2"/>
    <xacro:property name="box_z" value="0.05"/>



    <xacro:property name="link_one_base_radius" value="0.05"/>
    <xacro:property name="link_one_base_length" value="0.025"/>

    
    <link name="link_one">
        <visual>
            <geometry>
                <cylinder radius="${link_one_base_radius}" length="${link_one_base_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${link_one_base_radius}" length="${link_one_base_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <inertial>
            <origin xyz="0 0 0.1" rpy="0 0 0"/> <!-- Adjust Z to center of link -->
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="link_one_joint" type="continuous">
        <parent link="chassis"/>
        <child link="link_one"/>
        <origin xyz="0 0 ${box_z/2+link_one_base_length/2}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>

    </joint>

  
<gazebo reference="link_one">
    <material>Gazebo/Grey</material>
</gazebo>

</robot>